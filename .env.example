# Ashh Configuration

# Anthropic Claude API Key (leave blank or unset to run in Offline Extractive Mode)
ANTHROPIC_API_KEY=

# Model to use when API key is provided
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Chunking settings
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# Default retrieval settings
TOP_K=5

# Server settings
HOST=0.0.0.0
PORT=8000
